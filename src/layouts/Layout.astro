---
import '../styles/global.css';
import { SITE_CONFIG, getAbsoluteUrl } from '../config/site';
import JsonLd from '../components/seo/JsonLd.astro';
import SemanticContent from '../components/seo/SemanticContent.astro';
import type { ProjectItem, ArticleItem } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
  locale?: 'tr' | 'en';
  currentPath?: string;
  alternateTrPath?: string;
  alternateEnPath?: string;
  project?: ProjectItem;
  article?: ArticleItem;
}

const {
  locale = 'tr',
  currentPath = Astro.url.pathname,
  title = locale === 'tr' ? SITE_CONFIG.titleTr : SITE_CONFIG.titleEn,
  description = locale === 'tr' ? SITE_CONFIG.descriptionTr : SITE_CONFIG.descriptionEn,
  alternateTrPath = currentPath.startsWith('/en')
    ? currentPath.replace('/en/projects/', '/projeler/').replace('/en/articles/', '/makaleler/').replace('/en/', '/').replace('/en', '/')
    : currentPath,
  alternateEnPath = currentPath.startsWith('/en')
    ? currentPath
    : currentPath === '/'
    ? '/en/'
    : currentPath.replace('/projeler/', '/en/projects/').replace('/makaleler/', '/en/articles/'),
  project,
  article,
} = Astro.props;

const canonicalUrl = getAbsoluteUrl(currentPath);
const hreflangTrUrl = getAbsoluteUrl(alternateTrPath);
const hreflangEnUrl = getAbsoluteUrl(alternateEnPath);
const defaultUrl = getAbsoluteUrl(alternateTrPath); // x-default points to Turkish default
const ogImageUrl = `${SITE_CONFIG.domain}/assets/og-image.png`;
const ogImageAlt = locale === 'tr'
  ? 'Görkem Berk Gündoğdu — UI/UX Designer & Front-End Builder | Windows XP Portfolyosu'
  : 'Görkem Berk Gündoğdu — UI/UX Designer & Front-End Builder | Windows XP Portfolio';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Multi-Format Favicon Setup -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    
    <meta name="generator" content={Astro.generator} />

    <!-- Editorial Case Study Fonts (Plus Jakarta Sans & Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Reciprocal Hreflang Tags -->
    <link rel="alternate" hreflang="tr" href={hreflangTrUrl} />
    <link rel="alternate" hreflang="en" href={hreflangEnUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.author} />
    <meta name="theme-color" content="#0055ea" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={project ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data JSON-LD Graph -->
    <JsonLd
      currentPath={currentPath}
      title={title}
      description={description}
      locale={locale}
      project={project}
      article={article}
    />
  </head>
  <body class="bg-[#004e98] overflow-hidden">
    <!-- Server-Rendered Semantic HTML Fallback & Landmarks -->
    <SemanticContent locale={locale} activeProject={project} />

    <!-- Interactive Client Shell -->
    <div class="w-full h-full">
      <slot />
    </div>
  </body>
</html>

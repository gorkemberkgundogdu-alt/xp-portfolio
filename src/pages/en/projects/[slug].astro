---
import Layout from '../../../layouts/Layout.astro';
import { AdaptiveShell } from '../../../components/AdaptiveShell';
import { PROJECTS_DATA, type ProjectItem } from '../../../data/portfolioData';

export function getStaticPaths() {
  return PROJECTS_DATA.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const currentPath = `/en/projects/${project.slug}/`;
const alternateTrPath = `/projeler/${project.slug}/`;
---

<Layout
  locale="en"
  title={`${project.titleEn} | Görkem Berk Gündoğdu`}
  description={project.summaryEn}
  currentPath={currentPath}
  alternateTrPath={alternateTrPath}
  alternateEnPath={currentPath}
  project={project}
>
  <AdaptiveShell
    client:only="react"
    currentLocale="en"
    initialWindow="projects"
    initialProjectSlug={project.slug}
    initialPropertiesTab="projects"
  />
</Layout>

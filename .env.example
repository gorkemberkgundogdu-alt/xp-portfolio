# Public Supabase Project Configuration (Client-safe)
# These are exposed in client JavaScript to invoke the Supabase Edge Function.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ------------------------------------------------------------------------------
# NOTE: The following secrets are NEVER placed in client .env or GitHub client builds.
# They are configured EXCLUSIVELY in the Supabase Dashboard under Project Settings -> Edge Functions -> Secrets:
#
# RESEND_API_KEY=re_123456789
# CONTACT_NOTIFICATION_EMAIL=gorkemberkgundogdu@gmail.com
# CONTACT_FROM_EMAIL=onboarding@resend.dev (or your verified domain sender e.g. hello@yourdomain.com)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Strava Sync Script Configuration (Local / CI sync only - Never exposed to client)
# ------------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=


---
import {
  IDENTITY_DATA,
  PROJECTS_DATA,
  ARTICLES_DATA,
  SKILL_TOOL_ITEMS,
  CATEGORY_GROUPS,
  ABOUT_SECTIONS,
  type ProjectItem,
} from '../../data/portfolioData';

interface Props {
  locale: 'tr' | 'en';
  activeProject?: ProjectItem;
}

const { locale, activeProject } = Astro.props;
---

<!-- Semantic Server-Rendered Content & Accessible Fallback -->
<noscript>
  <div style="background-color: #ECE9D8; color: #111; padding: 2rem; font-family: Tahoma, Arial, sans-serif; max-width: 900px; margin: 1.5rem auto; border: 2px solid #0055EA; border-radius: 8px;">
    <header style="border-bottom: 2px solid #0055EA; padding-bottom: 1rem; margin-bottom: 1.5rem;">
      <h1 style="color: #0055EA; font-size: 1.8rem; margin: 0 0 0.5rem 0;">
        {IDENTITY_DATA.name} — {locale === 'tr' ? IDENTITY_DATA.titleTr : IDENTITY_DATA.titleEn}
      </h1>
      <p style="margin: 0; color: #444; font-size: 0.95rem;">
        {locale === 'tr' ? IDENTITY_DATA.taglineTr : IDENTITY_DATA.taglineEn} | {locale === 'tr' ? IDENTITY_DATA.locationTr : IDENTITY_DATA.locationEn}
      </p>
    </header>

    <main>
      <section style="margin-bottom: 2rem;">
        <h2 style="color: #003399; font-size: 1.3rem;">{locale === 'tr' ? 'Hakkında' : 'About'}</h2>
        <div style="display: grid; gap: 1rem;">
          {ABOUT_SECTIONS.map((sec) => (
            <article style="background: #fff; padding: 1rem; border: 1px solid #ccc; border-radius: 4px;">
              <h3 style="margin: 0 0 0.5rem 0; font-size: 1.05rem; color: #003399;">
                {locale === 'tr' ? sec.titleTr : sec.titleEn}
              </h3>
              {(locale === 'tr' ? sec.contentTr : sec.contentEn).map((p) => (
                <p style="margin: 0 0 0.5rem 0; line-height: 1.6; font-size: 0.95rem;">
                  {p}
                </p>
              ))}
            </article>
          ))}
        </div>
      </section>

      <section style="margin-bottom: 2rem;">
        <h2 style="color: #003399; font-size: 1.3rem;">{locale === 'tr' ? 'Projeler' : 'Projects'}</h2>
        <div style="display: grid; gap: 1rem;">
          {PROJECTS_DATA.map((p) => (
            <article style="background: #fff; padding: 1rem; border: 1px solid #ccc; border-radius: 4px;">
              <h3 style="margin: 0 0 0.25rem 0; font-size: 1.1rem;">
                <a href={locale === 'tr' ? `/projeler/${p.slug}/` : `/en/projects/${p.slug}/`} style="color: #0055EA; text-decoration: underline;">
                  {locale === 'tr' ? p.titleTr : p.titleEn}
                </a>
              </h3>
              <p style="margin: 0 0 0.5rem 0; font-size: 0.85rem; color: #666;">
                <strong>{locale === 'tr' ? p.categoryTitleTr : p.categoryTitleEn}</strong> | {p.date}
              </p>
              <p style="margin: 0 0 0.5rem 0; font-size: 0.9rem; line-height: 1.5;">
                {locale === 'tr' ? p.summaryTr : p.summaryEn}
              </p>
              <p style="margin: 0; font-size: 0.85rem; color: #444;">
                <strong>{locale === 'tr' ? 'Teknolojiler:' : 'Technologies:'}</strong> {p.tech.join(', ')}
              </p>
              {p.slug === 'operater' && (
                <div style="margin-top: 0.75rem; padding: 0.75rem; background: #f5f5f5; border-left: 3px solid #7C3AED; font-size: 0.85rem;">
                  <h4 style="margin: 0 0 0.25rem 0; color: #5B21B6;">
                    {locale === 'tr' ? 'Operater.io Detaylı Ürün Vaka Çalışması Bölümleri:' : 'Operater.io Detailed Product Case Study Sections:'}
                  </h4>
                  <ul style="margin: 0; padding-left: 1.25rem; line-height: 1.5;">
                    <li><strong>01 — Onboarding:</strong> {locale === 'tr' ? 'İlk Karşılaşmadan Değer Üretimine (Hesap, Şirket Bağlamı, Ajan Seçimi, Araç Entegrasyonları)' : 'From First Touch to Value (Account, Context, Agents, Tools)'}</li>
                    <li><strong>02 — Dashboard:</strong> {locale === 'tr' ? 'Operasyonel Genel Bakış & İnsan Denetimi (HITL, Akıl Yürütme İzleri, Durum Yönetimi)' : 'Operational Overview & Human-in-the-Loop (HITL, Reasoning, States)'}</li>
                    <li><strong>03 — Settings & Governance:</strong> {locale === 'tr' ? 'Ayarlar & Kurumsal Yönetişim (Kademeli Otonomi Seviyeleri, Eskalasyon Kuralları, Analitik)' : 'Settings & Enterprise Governance (Graduated Autonomy, Rules, Analytics)'}</li>
                    <li><strong>{locale === 'tr' ? 'Tasarım Süreci:' : 'Design Process:'}</strong> {locale === 'tr' ? 'Keşif, Tasarım Sistemi Mimarisi, Kod Prototipleme, Geliştirici Teslimi' : 'Discovery, Design System Architecture, Prototyping, Handoff'}</li>
                    <li><strong>{locale === 'tr' ? 'Çıktılar:' : 'Outcomes:'}</strong> {locale === 'tr' ? 'Yayına Alınan Kapsam, Tasarım Sistemi Temeli, Ekiplere Sağlanan Yetkinlikler' : 'Shipped Scope, Design System Foundation, Enabled Team Velocity'}</li>
                  </ul>
                </div>
              )}
              {p.slug === 'studio-v1be' && (
                <div style="margin-top: 0.75rem; padding: 0.75rem; background: #f5f5f5; border-left: 3px solid #137A3C; font-size: 0.85rem;">
                  <h4 style="margin: 0 0 0.25rem 0; color: #137A3C;">
                    {locale === 'tr' ? 'Studio v1be Web Tasarım & Geliştirme Vaka Çalışması Bölümleri:' : 'Studio v1be Web Design & Development Case Study Sections:'}
                  </h4>
                  <ul style="margin: 0; padding-left: 1.25rem; line-height: 1.5;">
                    <li><strong>01 — {locale === 'tr' ? 'Marka & Pozisyonlama:' : 'Brand & Positioning:'}</strong> {locale === 'tr' ? 'Aynı Marka, Farklı Görev (v1be Görsel DNA\'sı, Prosedürel Maskot ve Koyu Mimari Tema)' : 'Same Brand, Different Job (v1be Visual DNA, Procedural Mascot & Dark Theme)'}</li>
                    <li><strong>02 — {locale === 'tr' ? 'Bilgi Hiyerarşisi:' : 'Information Hierarchy:'}</strong> {locale === 'tr' ? 'İlk Ekranda Anlatmak (WHAT, WHY, HOW Kademeli Anlatım Sırası)' : 'Making It Clear on the First Screen (WHAT, WHY, HOW Progressive Narrative)'}</li>
                    <li><strong>03 — {locale === 'tr' ? 'Etkileşim & Animasyon:' : 'Interaction & Motion:'}</strong> {locale === 'tr' ? 'Özel Vanilla TypeScript Paginated Wheel Deneyimi (Sıfır Harici Kütüphane)' : 'Custom Vanilla TypeScript Paginated Wheel Controller (Zero External Libraries)'}</li>
                    <li><strong>04 — {locale === 'tr' ? 'Duyarlı Tasarım:' : 'Responsive Architecture:'}</strong> {locale === 'tr' ? 'Responsive Benim İçin Ölçek Değil Davranış Değişimi (Masaüstü Paging vs Mobil Doğal Akış)' : 'Responsive Isn\'t Scale, It\'s a Change in Behavior (Desktop Paging vs Mobile Natural Flow)'}</li>
                    <li><strong>05 — {locale === 'tr' ? 'Dönüşüm Mimarisi:' : 'Conversion Architecture:'}</strong> {locale === 'tr' ? 'Karar Anı Tek Bir Yerde Oluşmuyor (Packages İnteraktif Brief Konfigüratörü & Audit CTA)' : 'Decision Moments Don\'t Happen in One Place (Packages Brief Configurator & Audit CTA)'}</li>
                    <li><strong>06 — {locale === 'tr' ? 'Süreç İletişimi:' : 'Process Visualization:'}</strong> {locale === 'tr' ? 'Süreci Yazmak Yerine Görünür Hale Getirmek (4 Makro Aşama & İncelenebilir Kod Terminalleri)' : 'Making Process Visible (4 Macro Stages & Inspectable Code Terminals)'}</li>
                    <li><strong>07 — {locale === 'tr' ? 'İçerik Mimarisi:' : 'Content Architecture:'}</strong> {locale === 'tr' ? 'Work ve Labs Ayrımı (Case 001, Case 002 ve LAB 001 AI Crawlability Deneyi)' : 'Work & Labs Distinction (Case 001, Case 002 & LAB 001 AI Crawlability Experiment)'}</li>
                    <li><strong>08 — {locale === 'tr' ? 'Geliştirme & Teslimat:' : 'Front-End & Delivery:'}</strong> {locale === 'tr' ? 'Tasarım Dosyada Kalmadı (Astro v7, TypeScript, Tailwind v4, Three.js, Sıfır Framework Adası)' : 'The Design Didn\'t Stop in Design File (Astro v7, TypeScript, Tailwind v4, Three.js, Zero Islands)'}</li>
                    <li><strong>09 — {locale === 'tr' ? 'SEO & GEO Altyapısı:' : 'SEO & GEO Foundations:'}</strong> {locale === 'tr' ? 'Görünmenin Ötesinde Anlaşılmak (Dinamik llms.txt, JSON-LD Şeması, Robots Direktifleri, LAB 001)' : 'Being Understood Beyond Being Seen (Dynamic llms.txt, JSON-LD Schema, Robots, LAB 001)'}</li>
                  </ul>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <section style="margin-bottom: 2rem;">
        <h2 style="color: #003399; font-size: 1.3rem;">{locale === 'tr' ? 'Makaleler' : 'Articles'}</h2>
        <div style="display: grid; gap: 1rem;">
          {ARTICLES_DATA.map((a) => (
            <article style="background: #fff; padding: 1rem; border: 1px solid #ccc; border-radius: 4px;">
              <h3 style="margin: 0 0 0.25rem 0; font-size: 1.1rem;">
                <a href={locale === 'tr' ? `/makaleler/${a.slugTr}/` : `/en/articles/${a.slugEn}/`} style="color: #0055EA; text-decoration: underline;">
                  {locale === 'tr' ? a.titleTr : a.titleEn}
                </a>
              </h3>
              <p style="margin: 0; font-size: 0.9rem; line-height: 1.5;">
                {locale === 'tr' ? a.summaryTr : a.summaryEn}
              </p>
            </article>
          ))}
        </div>
      </section>

      <section style="margin-bottom: 2rem;">
        <h2 style="color: #003399; font-size: 1.3rem;">{locale === 'tr' ? 'Yetkinlikler & Araçlar' : 'Skills & Tools'}</h2>
        <div style="display: grid; gap: 1.25rem;">
          {CATEGORY_GROUPS.map((cat) => (
            <div>
              <h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem; color: #003399; border-bottom: 1px solid #ddd; padding-bottom: 0.25rem;">
                {locale === 'tr' ? cat.titleTr : cat.titleEn}
              </h3>
              <div style="display: grid; gap: 0.75rem; padding-left: 0.5rem;">
                {cat.subgroups.map((sub) => (
                  <div>
                    <h4 style="margin: 0 0 0.25rem 0; font-size: 0.95rem; color: #444;">
                      {locale === 'tr' ? sub.titleTr : sub.titleEn}
                    </h4>
                    <ul style="margin: 0; padding-left: 1.25rem; line-height: 1.6; font-size: 0.9rem;">
                      {sub.items.map((item) => (
                        <li style="margin-bottom: 0.5rem;">
                          <strong>{item.title}:</strong> {locale === 'tr' ? item.descriptionTr : item.descriptionEn}
                          {item.evidence && item.evidence.length > 0 && (
                            <div style="margin-top: 0.2rem; font-size: 0.85rem; color: #555;">
                              <em>{locale === 'tr' ? 'Kanıt:' : 'Evidence:'}</em>{' '}
                              {item.evidence.map((ev, i) => (
                                <span>
                                  {i > 0 && ', '}
                                  {ev.projectSlug ? (
                                    <a href={locale === 'tr' ? `/projeler/${ev.projectSlug}/${ev.anchor || ''}` : `/en/projects/${ev.projectSlug}/${ev.anchor || ''}`} style="color: #0055EA;">
                                      {ev.projectTitle} {ev.areaTr ? `(${locale === 'tr' ? ev.areaTr : ev.areaEn})` : ''}
                                    </a>
                                  ) : (
                                    <span>{ev.projectTitle} {ev.areaTr ? `(${locale === 'tr' ? ev.areaTr : ev.areaEn})` : ''}</span>
                                  )}
                                </span>
                              ))}
                            </div>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <footer style="border-top: 1px solid #ccc; padding-top: 1rem; font-size: 0.9rem;">
        <p style="margin: 0 0 0.5rem 0;">
          <strong>{locale === 'tr' ? 'İletişim:' : 'Contact:'}</strong>{' '}
          <a href={`mailto:${IDENTITY_DATA.social.email}`}>{IDENTITY_DATA.social.email}</a> |{' '}
          <a href={IDENTITY_DATA.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> |{' '}
          <a href={IDENTITY_DATA.social.github} target="_blank" rel="noopener noreferrer">GitHub</a> |{' '}
          <a href={IDENTITY_DATA.social.cvPath} download>CV (PDF)</a>
        </p>
      </footer>
    </main>
  </div>
</noscript>

<!-- Semantic Crawler / Assistive Technology Header Landmarks -->
<header class="sr-only">
  <h1>{locale === 'tr' ? IDENTITY_DATA.name + ' — UI/UX Designer & Front-End Builder' : IDENTITY_DATA.name + ' — UI/UX Designer & Front-End Builder'}</h1>
  <p>{locale === 'tr' ? IDENTITY_DATA.aboutShortTr : IDENTITY_DATA.aboutShortEn}</p>
  <nav aria-label="Site Navigation">
    <ul>
      <li><a href={locale === 'tr' ? '/' : '/en/'}>{locale === 'tr' ? 'Ana Sayfa' : 'Home'}</a></li>
      {PROJECTS_DATA.map((p) => (
        <li>
          <a href={locale === 'tr' ? `/projeler/${p.slug}/` : `/en/projects/${p.slug}/`}>
            {locale === 'tr' ? p.titleTr : p.titleEn}
          </a>
        </li>
      ))}
      {ARTICLES_DATA.map((a) => (
        <li>
          <a href={locale === 'tr' ? `/makaleler/${a.slugTr}/` : `/en/articles/${a.slugEn}/`}>
            {locale === 'tr' ? a.titleTr : a.titleEn}
          </a>
        </li>
      ))}
      <li><a href={IDENTITY_DATA.social.cvPath}>CV_2026.pdf</a></li>
    </ul>
  </nav>
</header>

---
import Layout from '../layouts/Layout.astro';
import { AdaptiveShell } from '../components/AdaptiveShell';
import { SITE_CONFIG } from '../config/site';

const title = SITE_CONFIG.titleTr;
const description = SITE_CONFIG.descriptionTr;
---

<Layout
  locale="tr"
  title={title}
  description={description}
  currentPath="/"
  alternateTrPath="/"
  alternateEnPath="/en/"
>
  <AdaptiveShell
    client:only="react"
    currentLocale="tr"
    initialWindow="readme"
    initialPropertiesTab="general"
  />
</Layout>
